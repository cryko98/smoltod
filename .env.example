# Copy to .env for `vercel dev`, and set the same value in the Vercel
# dashboard (Settings -> Environment Variables) for the deployed site.

# Required. Your fal.ai API key: https://fal.ai/dashboard/keys
FAL_KEY=

# Optional. Only needed if https://<your-domain>/assets/smol-tod.jpg is not
# publicly reachable (e.g. the deployment is behind Vercel Authentication).
# PFP_BASE_IMAGE=https://example.com/smol-tod.jpg
